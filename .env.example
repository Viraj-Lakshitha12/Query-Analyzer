# Anthropic / AI (use whichever API the project now uses)
GEMINI_API_KEY=your-gemini-api-key-here

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/queryanalyzer
SPRING_DATASOURCE_USERNAME=qa_user
SPRING_DATASOURCE_PASSWORD=your-db-password

# Security — generate a random 256-bit string, never commit the real value
JWT_SECRET=replace-with-a-random-256-bit-secret-string

# Sample app SDK key (get this from the Apps page after registering)
SAMPLE_APP_SDK_KEY=ql_live_your-sdk-key-here
